void InputState::clear() {
    pressedKeys.clear();
    pressedButtons.clear();
    modifiers = 0;
    mouseX = mouseY = 0.0f;
    lastMouseX = lastMouseY = 0.0f;
    lastWheelDir = WheelDirection::None;
    lastWheelDelta = 0;
    gamepadButtons.clear();
    gamepadAxes.clear();
    joystickButtons.clear();
    joystickAxes.clear();
    lastInputTime = 0;
}

