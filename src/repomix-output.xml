        "} "
        "QPushButton:hover { background: rgba(255, 255, 255, 0.3); } "
        "QPushButton:pressed { background: rgba(255, 255, 255, 0.4); }"
    );
    layout->addWidget(m_unlockButton, 0, Qt::AlignCenter);
    
    // Dark semi-transparent background
