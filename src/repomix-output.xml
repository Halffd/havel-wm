void ComboSequence::addInput(const ComboInput& input) {
    inputs.push_back(input);
    if (startTime == 0) {
        startTime = 1;  // Will be set properly on first input
    }
}

void ComboSequence::clear() {
    inputs.clear();
    startTime = 0;
}

