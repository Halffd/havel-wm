<?xml version="1.0" encoding="UTF-8"?>
<protocol name="virtual_keyboard">
  <copyright>
    Copyright (C) 2017 Martin Gräßlin
    This protocol is licensed under the MIT license.
  </copyright>

  <interface name="zwp_virtual_keyboard_v1" version="1">
    <request name="keymap">
      <arg name="format" type="uint" enum="keymap_format"/>
      <arg name="fd" type="fd" summary="keymap file descriptor"/>
      <arg name="size" type="uint" summary="keymap size, in bytes"/>
    </request>
    <request name="key">
      <arg name="time" type="uint" summary="timestamp with millisecond granularity"/>
      <arg name="key" type="uint" summary="key code originating the event, _EVDEVMAP otherwise"/>
      <arg name="state" type="uint" enum="key_state"/>
    </request>

    <enum name="keymap_format">
      <entry name="no_keymap" value="0"/>
      <entry name="xkb_v1" value="1"/>
    </enum>
    <enum name="key_state" since="1">
      <entry name="released" value="0"/>
      <entry name="pressed" value="1"/>
    </enum>
  </interface>

  <interface name="zwp_virtual_keyboard_manager_v1" version="1">
    <request name="create_virtual_keyboard">
      <arg name="seat" type="object" interface="wl_seat"/>
      <arg name="id" type="new_id" interface="zwp_virtual_keyboard_v1"/>
    </request>
  </interface>
</protocol>
