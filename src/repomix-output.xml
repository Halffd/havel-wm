    , m_createdLabel(nullptr)
    , m_pathLabel(nullptr)
    , m_appList(nullptr)
    , m_chooseAppButton(nullptr)
    , m_ownerRead(nullptr)
    , m_ownerWrite(nullptr)
    , m_ownerExec(nullptr)
    , m_groupRead(nullptr)
    , m_groupWrite(nullptr)
    , m_groupExec(nullptr)
    , m_otherRead(nullptr)
    , m_otherWrite(nullptr)
    , m_otherExec(nullptr)
