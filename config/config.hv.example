// Havel WM startup config
//
// Copy to ~/.config/havel-wm/config.hv; the compositor runs it at start.
// Scripts execute synchronously before the frame loop - config-style
// quick operations only, no blocking loops.

// ---------------------------------------------------------------------
// Pointer
//
// cursor_mode("auto")     hardware cursor plane when the backend has one
//                         (wlroots' default choice)
// cursor_mode("software") force the cursor into the framebuffer - use it
//                         when the backend advertises a plane it does not
//                         composite, or to have the cursor show up in
//                         screen captures
// ---------------------------------------------------------------------

cursor_mode("auto")

// Wallpaper: a PNG drawn behind every window; "" clears back to the
// solid background colour.
// set_wallpaper("/home/agent/pictures/wallpaper.png")

// Window placement mode: "cascade" | "center" | "pointer"
// HAVEL_PLACEMENT=center  (env var, not Havel — read at startup)

// ---------------------------------------------------------------------
// Plugin settings
//
// plugin_config(plugin, key, value) writes the setting and applies it to
// the running plugin immediately.
// ---------------------------------------------------------------------

// Alt-Tab task switcher (Windows-style grid)
plugin_config("alt_tab", "columns", 3)          // grid columns (default 3)
plugin_config("alt_tab", "monitor", "cursor")   // cursor | main | fixed
plugin_config("alt_tab", "monitorIndex", 0)     // used when monitor = fixed
plugin_config("alt_tab", "thumbnailWidth", 360) // cell width in px
plugin_config("alt_tab", "thumbnailHeight", 240)// cell height in px
plugin_config("alt_tab", "maxVisibleWindows", 12)
plugin_config("alt_tab", "bgColor", "0,0,0,0.7")        // dim behind the grid
plugin_config("alt_tab", "borderColor", "1,1,1,1")      // selected cell border
plugin_config("alt_tab", "textColor", "0.92,0.92,0.92,1")
plugin_config("alt_tab", "keybinding", "Alt+Tab")       // cycle + select on release

plugin_config("app_launcher", "keybinding", "Meta+D")  // open/close the grid
plugin_config("app_launcher", "terminal", "foot")      // run Terminal=true apps here
// Script/panel access: plugin_command("app_launcher", "open"|"close"|"toggle")

// Panel (taskbar): launcher button, workspace buttons, window buttons,
// clock. Keys act per monitor; the workarea reservation keeps windows
// clear of the panel.
plugin_config("workspace_info_bar", "position", "top")    // top | bottom
plugin_config("workspace_info_bar", "height", "30")       // px (16..80)
plugin_config("workspace_info_bar", "clock_format", "%H:%M")
plugin_config("workspace_info_bar", "show_workspaces", "true")
plugin_config("workspace_info_bar", "show_launcher_button", "true")
plugin_config("workspace_info_bar", "show_clock", "true")
plugin_config("workspace_info_bar", "keybinding", "Meta+Shift+B") // toggle

// ---------------------------------------------------------------------

// Zoom (Wayfire-style: fullscreen scale + lens/strip/custom magnifiers)
//
// Keybindings - the gate comes from the "keybinding" spec's modifiers;
// Plus/Minus/0 step in/out/reset, the spec's key toggles, M cycles mode,
// Space (hold) is push-to-zoom. Keys act on the monitor under the cursor.
// Modes: "fullscreen" (scale + cursor-centred pan), "lens" (box following
// the cursor), "strip" (full-width band at the top or bottom edge),
// "custom" (fixed box, top-right by default).
plugin_config("zoom", "keybinding", "Meta+Ctrl+Z")
plugin_config("zoom", "step", "1.25")          // multiplicative in/out step
plugin_config("zoom", "toggle_level", "2.0")   // level used by toggle/push
plugin_config("zoom", "smoothing_ms", "300")   // animation time constant
plugin_config("zoom", "lens_w", "240")         // lens display box
plugin_config("zoom", "lens_h", "240")
plugin_config("zoom", "lens_dx", "40")         // lens offset from the cursor
plugin_config("zoom", "lens_dy", "40")
plugin_config("zoom", "strip_h", "140")        // strip band height
plugin_config("zoom", "strip_bottom", "false") // strip at the bottom edge
plugin_config("zoom", "custom_w", "420")       // custom magnifier box
plugin_config("zoom", "custom_h", "300")
plugin_config("zoom", "custom_x", "-1")        // -1 = top-right auto position
plugin_config("zoom", "custom_y", "-1")

// Script access: zoom("in"|"out"|"reset"|"toggle", output) and
// zoom("mode", output, 0-3) or zoom("status") for the JSON state.
// zoom("in", 0)

// ---------------------------------------------------------------------
// Keybindings
//
// keybind(spec, fn) - spec is "Mods+Key"; the closure runs on press.
// Modifiers: Ctrl, Alt, Shift, Meta (also Super/Logo).
// ---------------------------------------------------------------------

keybind("Meta+Return", fn() {
    spawn("foot")
})

keybind("Meta+1", fn() {
    workspace(0)
})

keybind("Meta+2", fn() {
    workspace(1)
})

keybind("Meta+Shift+W", fn() {
    notify("havel-wm", "config.hv is live")
})
