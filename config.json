{
  "plugins": {
    "example": {
      "enabled": true
    },
    "blur": {
      "enabled": false
    },
    "scale": {
      "enabled": false
    },
    "wallpaper": {
      "enabled": true,
      "color": { "r": 0.1, "g": 0.1, "b": 0.15 }
    },
    "notifications": {
      "enabled": true
    },
    "custom_layouts": {
      "enabled": false
    },
    "window_snap": {
      "enabled": true,
      "snap_distance": 20
    },
    "hot_corners": {
      "enabled": true,
      "trigger_delay_ms": 250,
      "corners": {
        "top_left": "overview",
        "top_right": "windows",
        "bottom_left": "desktop",
        "bottom_right": "none"
      }
    },
    "gamma": {
      "enabled": true
    },
    "app_launcher": {
      "enabled": true
    },
    "alt_tab": {
      "enabled": true
    },
    "overview": {
      "enabled": true
    },
    "server_decoration": {
      "enabled": true,
      "title_bar_height": 32,
      "border_width": 1
    }
  },
  "keybindings": {
    "terminal": { "mod": "MOD_LOGO", "key": "Return" },
    "browser": { "mod": "MOD_LOGO", "key": "B" },
    "file_manager": { "mod": "MOD_LOGO", "key": "E" },
    "close_window": { "mod": "MOD_LOGO", "key": "Q" },
    "toggle_floating": { "mod": "MOD_LOGO", "key": "Space" },
    "toggle_maximize": { "mod": "MOD_LOGO", "key": "M" },
    "toggle_fullscreen": { "mod": "MOD_LOGO", "key": "F" },
    "workspace_1": { "mod": "MOD_LOGO", "key": "1" },
    "workspace_2": { "mod": "MOD_LOGO", "key": "2" },
    "workspace_3": { "mod": "MOD_LOGO", "key": "3" },
    "workspace_4": { "mod": "MOD_LOGO", "key": "4" },
    "workspace_5": { "mod": "MOD_LOGO", "key": "5" },
    "workspace_6": { "mod": "MOD_LOGO", "key": "6" },
    "workspace_7": { "mod": "MOD_LOGO", "key": "7" },
    "workspace_8": { "mod": "MOD_LOGO", "key": "8" },
    "workspace_9": { "mod": "MOD_LOGO", "key": "9" },
    "overview": { "mod": "MOD_LOGO", "key": "W" },
    "app_launcher": { "mod": "MOD_LOGO", "key": "D" },
    "toggle_grayscale": { "mod": "MOD_LOGO", "key": "G" },
    "toggle_negative": { "mod": "MOD_LOGO", "key": "N" },
    "quit": { "mod": "MOD_LOGO|MOD_CTRL", "key": "F4" }
  },
  "general": {
    "startup_command": null,
    "cursor_theme": "default",
    "cursor_size": 24
  }
}
