    layout->addWidget(m_statusLabel, 0, Qt::AlignCenter);
    
    // Unlock button
    m_unlockButton->setFixedWidth(150);
    m_unlockButton->setFixedHeight(40);
    m_unlockButton->setStyleSheet(
